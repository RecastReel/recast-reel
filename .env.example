# ── Run it yourself ────────────────────────────────────────────────
# Only this is needed for `npm run dev`. Videos are charged to this key.
# Get one at https://www.madebycue.dev
CUE_API_KEY=

# Everything below is optional locally and required in production.
# Locally there's no sign-in or billing, and the database is an embedded
# Postgres in .data/. Set LOCAL_MODE=0 to try the hosted sign-in/billing flow.
LOCAL_MODE=

# ── Auth (Better Auth) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=               # e.g. https://recastreel.com (defaults to http://localhost:3000 locally)

# ── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Recast Reel <noreply@recastreel.com>

# ── Database (Neon Postgres) ───────────────────────────────────────
DATABASE_URL=

# ── Payments (Freemius). Setting FREEMIUS_API_KEY turns billing on. ─
# Copy the first four from Freemius Dashboard → Settings → API & Keys → .env.
# Server-only: never expose these to the browser or commit them.
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
# Optional overrides; verified public plan/pricing IDs are built into lib/credit-packs.ts.
FREEMIUS_TOPUP_PLAN_ID=        # dedicated credit top-up plan; one-off prices ONLY
FREEMIUS_PRICING_ID_TOPUP_10=   # quota 10, USD one-off price 12.20
FREEMIUS_PRICING_ID_TOPUP_25=   # quota 25, USD one-off price 30.50
FREEMIUS_PRICING_ID_TOPUP_50=   # quota 50, USD one-off price 61.00
FREEMIUS_PRICING_ID_TOPUP_100=  # quota 100, USD one-off price 122.00
FREEMIUS_PLAN_ID=              # legacy subscription plan ID, retain for existing credits only
FREEMIUS_SANDBOX=true          # test cards; set to false to take real payments
# In the Freemius Dashboard set:
#   Webhook URL:           https://<your-domain>/api/webhooks/freemius
#   Checkout redirect URL: https://<your-domain>/api/billing/redirect
MONTHLY_CREDIT_USD=20          # legacy monthly grant; keep historical value, no new monthly credits

# Optional override for the built-in US$99 Pro plan (78736).
FREEMIUS_MONTHLY_PLAN_ID=
