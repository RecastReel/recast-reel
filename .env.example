# ── Run it yourself ────────────────────────────────────────────────
# Only this is needed for `npm run dev`. Videos are charged to this key.
# Get one at https://www.madebycue.dev
CUE_API_KEY=

# Everything below is optional locally and required in production.
# Locally there's no sign-in or billing, and the database is an embedded
# Postgres in .data/. Set LOCAL_MODE=0 to try the hosted sign-in/billing flow.
LOCAL_MODE=

# ── Auth (Better Auth) ─────────────────────────────────────────────
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=               # e.g. https://recastreel.com (defaults to http://localhost:3000 locally)

# ── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Recast Reel <noreply@recastreel.com>

# ── Database (Neon Postgres) ───────────────────────────────────────
DATABASE_URL=

# ── Payments (Creem). Setting CREEM_API_KEY turns billing on. ──────
# Webhook URL: https://<your-domain>/api/auth/creem/webhook
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=              # the $25/month product
CREEM_TEST_MODE=1              # set to 0 in production
MONTHLY_VIDEO_SECONDS=120       # monthly allowance in seconds
